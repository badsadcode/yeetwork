[node name="Mabel" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -26, 0, 22)
script = ExtResource("talker")
display_name = "Mabel"
lines = PackedStringArray("Oh good, the Yeets. I'm Mabel. I do odd jobs round here. They're all odd.", "She's lost her glasses again, and she can't see a thing without them. She wrote to you herself. Well, she wrote to the toaster, but it got passed on.", "Her diary's on the desk. Up there. No, higher. Higher. There.", "You'll want the bookcase. The books at the far end make a good stair. And mind the dust. It bites.")
shirt = Color(0.75, 0.3, 0.45, 1)


[node name="TheLetter" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -20, 0, 20)
script = ExtResource("note")
title = "A Letter"
text = "To the small people, or the toaster,\n\nI seem to have put my glasses down somewhere. Could you find them? I would look myself, but I can't see where to start.\n\nThere's a biscuit in it for you.\n\nYours, Grandma\n\nP.S. Is that you, Harold?"


